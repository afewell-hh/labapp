[Unit]
Description=Native course VLAB {{ item.mode }}
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
Conflicts={{ 'hhfab-vlab-resume.service' if item.mode == 'build' else 'labapp-vlab-build.service' }}
# At most three starts per boot, not an unlimited recovery loop.
StartLimitIntervalSec=infinity
StartLimitBurst=3

[Service]
Type=exec
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/hhfab
Environment=HOME=/home/ubuntu
Environment=PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=TERM=dumb
{% if item.mode == 'build' %}
Environment=DOCKER_CONFIG=/run/labapp-build-registry
{% else %}
UnsetEnvironment=DOCKER_CONFIG
ReadOnlyPaths=/home/ubuntu/hhfab/result /home/ubuntu/hhfab/fab.yaml /home/ubuntu/hhfab/.registry.yaml /home/ubuntu/hhfab/include /home/ubuntu/hhfab/vlab/config.yaml /home/ubuntu/hhfab/vlab/sshkey
{% endif %}
UMask=0077
LimitCORE=0
StandardInput=null
StandardOutput=journal
StandardError=journal
ExecStartPre=+/usr/sbin/modprobe br_netfilter
ExecStartPre=+/usr/sbin/sysctl -w net.bridge.bridge-nf-call-iptables=0 net.bridge.bridge-nf-call-ip6tables=0 net.bridge.bridge-nf-call-arptables=0
ExecStart=/usr/local/libexec/labapp-vlab-run {{ item.mode }}
{% if item.mode == 'build' %}
ExecStartPost=/usr/bin/timeout --signal=TERM --kill-after=5s {{ item.seconds }} /usr/local/libexec/labapp-vlab-ready initial
{% else %}
# Link setup only: a diagnostic must not kill a running student's nested VMs.
ExecStartPost=+/usr/bin/timeout --signal=TERM --kill-after=5s {{ item.seconds }} /usr/local/libexec/labapp-vlab-bridge hhfab-vlab-resume.service
{% endif %}
TimeoutStartSec={{ item.seconds }}
TimeoutStopSec=30
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
{% if item.mode == 'build' %}
# A replacement process must not hide a failed immutable build.
Restart=no
{% else %}
Restart=on-failure
RestartSec=15
{% endif %}

[Install]
WantedBy=multi-user.target
