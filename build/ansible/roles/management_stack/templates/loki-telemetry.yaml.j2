# Loki6.49's chart Service does not support selecting a fixed nodePort value.
# Keep it intact; use a separate declarative telemetry Service, with no gateway.
apiVersion: v1
kind: Service
metadata:
  name: loki-telemetry
  namespace: monitoring
spec:
  type: NodePort
  selector:
    app.kubernetes.io/name: loki
    app.kubernetes.io/instance: loki
    app.kubernetes.io/component: single-binary
  ports:
    - name: http-metrics
      port: 3100
      targetPort: http-metrics
      nodePort: 31000
