apiVersion: v1
kind: Secret
metadata:
  name: cluster-hedgehog-vlab
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: cluster
type: Opaque
stringData:
  name: hedgehog-vlab
  server: https://172.30.0.1:6443
  config: |
    {
{% if gitops_kube_users[0].user.token is defined %}
      "bearerToken": {{ gitops_kube_users[0].user.token | to_json }},
{% endif %}
      "tlsClientConfig": {
        "insecure": false,
        "caData": {{ gitops_kube_clusters[0].cluster['certificate-authority-data'] | to_json }}
{% if gitops_kube_users[0].user.token is not defined %}
        ,"certData": {{ gitops_kube_users[0].user['client-certificate-data'] | to_json }}
        ,"keyData": {{ gitops_kube_users[0].user['client-key-data'] | to_json }}
{% endif %}
      }
    }
