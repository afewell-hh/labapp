[Unit]
Description=Management trial expiry stop request (source-inactive, issue #508)

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/var/lib/labapp-management-trial
Environment=PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
UnsetEnvironment=SSH_AUTH_SOCK PYTHONPATH PYTHONHOME
ExecStart=/usr/bin/python3 /var/lib/labapp-management-trial/management_trial.py expire
Restart=no
TimeoutStartSec=30
StandardOutput=null
StandardError=null
